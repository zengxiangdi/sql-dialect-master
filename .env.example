# --- API ---
SDM_API_VERSION=1.5.0
SDM_API_TITLE="SQL Dialect Master API"
# Optional business endpoint authentication. Leave empty for local public use.
SDM_API_KEY=""
# Running and queued CPU tasks are bounded; busy requests return HTTP 503.
SDM_API_WORKERS=4
SDM_API_QUEUE_SIZE=4
SDM_ALLOWED_ORIGINS="http://localhost:8501,http://localhost:8000,http://127.0.0.1:8501,http://127.0.0.1:8000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174"
# Comma-separated proxy IPs/CIDRs; empty means X-Forwarded-For is never trusted.
SDM_TRUSTED_PROXIES=""
SDM_MAX_BATCH_SIZE=100
SDM_REQUEST_TIMEOUT=30
# Optional shared secret for non-loopback readiness/deep-health probes.
SDM_HEALTH_PROBE_TOKEN=""
# Metrics are disabled by default.
SDM_METRICS_ENABLED=false
# Required when metrics are enabled.
SDM_METRICS_TOKEN=""

# --- Cache ---
SDM_CACHE_ENABLED=true
SDM_CACHE_TTL=300
SDM_CACHE_MAX_SIZE=1000

# --- Rate Limiting ---
SDM_RATE_LIMIT_ENABLED=true
SDM_RATE_LIMIT_REQUESTS=100
SDM_RATE_LIMIT_WINDOW=60
# Use memory for a single process; use Redis for shared limits across workers/instances.
SDM_RATE_LIMIT_BACKEND=memory
# Required when SDM_RATE_LIMIT_BACKEND=redis.
SDM_REDIS_URL=""

# --- NL2SQL (Natural Language to SQL) ---
SDM_NL2SQL_CONFIDENCE_THRESHOLD=0.6
SDM_NL2SQL_MAX_SUGGESTIONS=5
SDM_NL2SQL_MAX_INPUT_LENGTH=8192
SDM_NL2SQL_MAX_DATE_INTERVAL_DAYS=36525

# Optional OpenRouter-compatible LLM generation for NL2SQL.
SDM_NL2SQL_LLM_ENABLED=false
SDM_NL2SQL_LLM_BASE_URL=https://openrouter.ai/api/v1
SDM_NL2SQL_LLM_API_KEY=""
SDM_NL2SQL_LLM_MODEL=""
SDM_NL2SQL_LLM_TIMEOUT=15
SDM_NL2SQL_LLM_MAX_TOKENS=800
SDM_NL2SQL_LLM_TEMPERATURE=0.0
SDM_NL2SQL_LLM_FALLBACK=true
SDM_NL2SQL_LLM_APP_NAME="SQL Dialect Master"
SDM_NL2SQL_LLM_APP_URL=""

# --- SQL Transpiler / Parser ---
SDM_TRANSPILER_PRETTY_DEFAULT=true
SDM_TRANSPILER_MAX_SQL_LENGTH=100000
SDM_PARSER_MAX_SQL_LENGTH=100000

# --- Function Encyclopedia ---
SDM_FUNCTION_SEARCH_LIMIT=50
SDM_FUNCTION_FUZZY_THRESHOLD=0.4

# --- Security ---
SDM_SECURITY_CHECK_ENABLED=true
SDM_SECURITY_BLOCK_DANGEROUS=true

# --- Logging ---
SDM_LOG_LEVEL=INFO
SDM_LOG_FILE=""
